# Example environment variables for the Alerta Temprana project
# Copy to .env and fill with real values. DO NOT commit your real .env to git.

# App
PORT=3000
NODE_ENV=production

# Database (MySQL)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# WhatsApp / messaging (providers supported in whatsappService)
# Provider: twilio | ultramsg | other
WHATSAPP_PROVIDER=twilio

# Twilio (if using Twilio)
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM_NUMBER=

# Generic WhatsApp API (if used)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_NUMBER=

# UltraMsg (if using UltraMsg)
WHATSAPP_ULTRAMSG_INSTANCE_ID=
WHATSAPP_ULTRAMSG_TOKEN=

# Add other production secrets here (Sentry, third-party keys, etc.)
# SENTRY_DSN=
